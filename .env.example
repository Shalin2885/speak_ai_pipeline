# ─────────────────────────────────────────────────────────────────────────────
# Speak AI Pipeline — Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM / Text Generation — FREE local inference via Ollama ──────────────────
# No API key needed! Install Ollama: https://ollama.com/download
# Then pull the default model:
#   ollama pull gemma3:1b          ← Default (small & fast, ~815 MB)
#   ollama pull llama3.1:8b        ← Best quality (~6 GB RAM)
#   ollama pull mistral:7b         ← Good alternative (~5 GB RAM)
#   ollama pull llama3.2:3b        ← Fastest / lowest RAM (~3 GB)
#   ollama pull phi3:mini          ← Smallest, CPU-friendly (~2 GB)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# ── HuggingFace (Whisper fine-tuning, Wav2Vec2) ───────────────────────────────
HF_TOKEN=your_huggingface_token_here
HF_HOME=./hf_cache

# ── Azure / Edge TTS (Repository 1 — edge_tts_synthesis) ─────────────────────
# No key required for edge-tts; set locale and voice defaults here:
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# ── XTTS / Coqui (Repository 1 — xtts_voice_cloning) ─────────────────────────
XTTS_MODEL_PATH=./hf_cache/xtts_v2
SPEAKER_REF_DIR=./input_audio/original

# ── Whisper fine-tuning (Repository 1 — finetune_whisper.py) ─────────────────
WHISPER_BASE_MODEL=openai/whisper-small
WHISPER_OUTPUT_DIR=./outputs/final_dataset/whisper_finetuned
WHISPER_MAX_STEPS=2000
WHISPER_BATCH_SIZE=16
WHISPER_LEARNING_RATE=1e-5

# ── Paths ─────────────────────────────────────────────────────────────────────
INPUT_AUDIO_DIR=./input_audio/original
NOISE_SAMPLES_DIR=./input_audio/noise_samples
PROCESSED_DIR=./data/processed
TRANSCRIPTS_DIR=./data/transcripts
AUGMENTED_DIR=./data/augmented
SYNTHETIC_DIR=./data/synthetic
MANIFESTS_DIR=./data/manifests

# ── Pipeline behaviour ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_WORKERS=4
SEED=42

