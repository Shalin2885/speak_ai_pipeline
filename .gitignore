# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets / environment ──────────────────────────────────────────────────────
.env
*.env.local

# ── Audio / data (keep directory stubs, ignore large files) ───────────────────
input_audio/original/**/*.wav
input_audio/original/**/*.mp3
input_audio/original/**/*.flac
input_audio/noise_samples/**/*.wav
data/processed/**
data/transcripts/**
data/augmented/**
data/synthetic/**
data/manifests/**
# keep .gitkeep stubs
!data/**/.gitkeep

# ── Model weights / caches ────────────────────────────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
hf_cache/
.cache/

# ── Outputs ───────────────────────────────────────────────────────────────────
outputs/logs/**
outputs/reports/**
outputs/final_dataset/**
!outputs/**/.gitkeep

# ── Editors / OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Third-party repos are tracked via git submodule / sparse checkout ─────────
# third_party/ is intentionally included (external repos kept read-only)

